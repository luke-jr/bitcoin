-        --add-modules java.xml.bind \
-        --add-exports java.desktop/sun.awt=ALL-UNNAMED \
-        --add-exports java.xml.bind/javax.xml.bind.annotation=ALL-UNNAMED \
+        $(if $(filter true,$(BUILD_TOOLS_ONLY)),,--add-modules java.xml.bind) \
+        $(BUILD_TOOLS_DESKTOP_EXPORT) \
+        $(if $(filter true,$(BUILD_TOOLS_ONLY)),,--add-exports java.xml.bind/javax.xml.bind.annotation=ALL-UNNAMED) \
         --add-exports java.base/sun.text=ALL-UNNAMED \
@@ -64,2 +78,3 @@
 
+ifneq ($(BUILD_TOOLS_ONLY), true)
 $(eval $(call SetupCopyFiles,COPY_NIMBUS_TEMPLATES, \
@@ -70,2 +85,3 @@
