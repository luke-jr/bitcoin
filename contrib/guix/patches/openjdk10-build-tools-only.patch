--- a/make/common/Modules.gmk
+++ b/make/common/Modules.gmk
@@ -321,2 +321,15 @@
 
+# A tools-only image must omit modules before every compilation phase, not
+# merely trim a complete JDK with jlink. Keep the compiler, archive/signing,
+# inspection and bootstrap tools, their dependencies, and required providers.
+ifeq ($(BUILD_TOOLS_ONLY), true)
+  BUILD_TOOL_MODULES := \
+      java.base java.compiler java.logging java.xml \
+      jdk.compiler jdk.crypto.ec jdk.internal.opt jdk.jartool jdk.javadoc \
+      jdk.jdeps jdk.jlink jdk.unsupported jdk.zipfs
+  MODULES_FILTER += $(filter-out $(BUILD_TOOL_MODULES), \
+      $(call GetModuleNameFromModuleInfo, $(MODULE_INFOS)))
+endif
+
+
 $(MODULE_DEPS_MAKEFILE): $(MODULE_INFOS) \
--- a/make/CompileToolsJdk.gmk
+++ b/make/CompileToolsJdk.gmk
@@ -38,2 +38,15 @@
 
+# These generators are used exclusively by java.desktop, which is not built
+# in a tools-only image. A tools-only boot JDK need not expose its GUI APIs.
+ifeq ($(BUILD_TOOLS_ONLY), true)
+  BUILD_TOOLS_DESKTOP_EXCLUDES := \
+      build/tools/compilefontconfig \
+      build/tools/dtdbuilder \
+      build/tools/generatenimbus \
+      build/tools/icondata/awt \
+      build/tools/x11wrappergen
+else
+  BUILD_TOOLS_DESKTOP_EXPORT := --add-exports java.desktop/sun.awt=ALL-UNNAMED
+endif
+
 # Use += to be able to add to this from a custom extension
@@ -48,2 +61,3 @@
     EXCLUDES := \
+        $(BUILD_TOOLS_DESKTOP_EXCLUDES) \
         build/tools/deps \
@@ -55,5 +69,5 @@
