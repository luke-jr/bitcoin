+++ b/common/autoconf/libraries.m4
@@ -40,2 +40,16 @@
 [
+  AC_ARG_ENABLE([build-tools-only],
+      [AS_HELP_STRING([--enable-build-tools-only],
+          [build only the modules needed by Java command-line and bootstrap tools])],
+      [case "$enable_build_tools_only" in
+         yes) BUILD_TOOLS_ONLY=true ;;
+         no) BUILD_TOOLS_ONLY=false ;;
+         *) AC_MSG_ERROR([--enable-build-tools-only accepts only yes or no]) ;;
+       esac],
+      [BUILD_TOOLS_ONLY=false])
+  AC_SUBST(BUILD_TOOLS_ONLY)
+  if test "x$BUILD_TOOLS_ONLY" = xtrue && test "x$ENABLE_HEADLESS_ONLY" != xtrue; then
+    AC_MSG_ERROR([--enable-build-tools-only requires --enable-headless-only])
+  fi
+
   # Check if X11 is needed
@@ -75,2 +89,11 @@
