include_guard(GLOBAL)

# A Knots release date distinguishes releases sharing a Core version. Reserve
# rank 99 for the final release so it follows every release candidate.
function(compute_android_version_code output suffix rc override)
  if(NOT "${override}" STREQUAL "")
    if(NOT "${override}" MATCHES "^[0-9]+$")
      message(FATAL_ERROR "ANDROID_VERSION_CODE must be a positive decimal integer")
    endif()
    string(REGEX REPLACE "^0+" "" version_code "${override}")
  else()
    if(NOT "${suffix}" MATCHES "^\\.knots([0-9]+)$")
      message(FATAL_ERROR "Android version code requires a .knotsYYYYMMDD suffix or an ANDROID_VERSION_CODE override")
    endif()
    set(release_date "${CMAKE_MATCH_1}")
    string(LENGTH "${release_date}" date_length)
    if(NOT date_length EQUAL 8)
      message(FATAL_ERROR "Android version code requires an eight-digit Knots release date")
    endif()
    string(SUBSTRING "${release_date}" 0 4 year_text)
    string(SUBSTRING "${release_date}" 4 2 month_text)
    string(SUBSTRING "${release_date}" 6 2 day_text)
    math(EXPR year "1${year_text} - 10000")
    math(EXPR month "1${month_text} - 100")
    math(EXPR day "1${day_text} - 100")
    set(days_in_month 31)
    if(month EQUAL 4 OR month EQUAL 6 OR month EQUAL 9 OR month EQUAL 11)
      set(days_in_month 30)
    elseif(month EQUAL 2)
      set(days_in_month 28)
      math(EXPR modulo4 "${year} % 4")
      math(EXPR modulo100 "${year} % 100")
      math(EXPR modulo400 "${year} % 400")
      if(modulo4 EQUAL 0 AND (NOT modulo100 EQUAL 0 OR modulo400 EQUAL 0))
        set(days_in_month 29)
      endif()
    endif()
    if(year LESS 1 OR month LESS 1 OR month GREATER 12 OR day LESS 1 OR day GREATER days_in_month)
      message(FATAL_ERROR "Android version code requires a valid Knots release date")
    endif()
    if(NOT "${rc}" MATCHES "^(0|[1-9][0-9]?)$" OR rc GREATER 98)
      message(FATAL_ERROR "Android release candidate must be 0 (final) or 1 through 98")
    endif()
    if(rc EQUAL 0)
      set(release_rank 99)
    else()
      set(release_rank "${rc}")
    endif()
    # Prefixing 1 avoids CMake's octal interpretation of leading zeroes.
    math(EXPR version_code "(1${release_date} - 100000000) * 100 + ${release_rank}")
  endif()

  # Check length before numeric comparison to reject oversized input without
  # overflowing CMake's integer parser. Google Play caps codes at 2100000000.
  string(LENGTH "${version_code}" code_length)
  if(code_length EQUAL 0 OR code_length GREATER 10)
    message(FATAL_ERROR "ANDROID_VERSION_CODE must be between 1 and 2100000000")
  endif()
  if(version_code LESS 1 OR version_code GREATER 2100000000)
    message(FATAL_ERROR "ANDROID_VERSION_CODE must be between 1 and 2100000000")
  endif()
  set(${output} "${version_code}" PARENT_SCOPE)
endfunction()
